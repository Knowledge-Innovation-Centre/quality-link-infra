# Example environment
# ===================
#
# Values commented out in this file show defaults that are set in
# docker-compose.yml if not contained in .env
#
# To expose for local development, use docker-compose.override.yml

#==============================================================================
# POSTGRES
#==============================================================================

# Database settings
POSTGRES_PASSWORD=your_postgres_password

#==============================================================================
# MINIO (S3-COMPATIBLE STORAGE)
#==============================================================================

# Image and basic config

# Authentication
MINIO_ROOT_PASSWORD=minio_password
MINIO_BUCKET_NAME=quality-link-storage

#==============================================================================
# APACHE JENA FUSEKI CONFIGURATION
#==============================================================================

# Access & permissions
FUSEKI_ADMIN_PASSWORD=fuseki_password

# Dataset settings
#FUSEKI_DATASET_NAME=qualitylink
#FUSEKI_TDB=2
#FUSEKI_ENABLE_DATA_WRITE=true
#FUSEKI_ENABLE_UPDATE=true

# JVM settings
#FUSEKI_JVM_ARGS="-Xmx2g -XX:+UseContainerSupport"


#==============================================================================
# MAGEAI
#==============================================================================

# Authentication
DEFAULT_OWNER_EMAIL=your_email@example.com
DEFAULT_OWNER_USERNAME=your_username
DEFAULT_OWNER_PASSWORD=your_password

# repository with MageAI pipelines
#MAGE_WORKFLOW_REPO=https://github.com/Knowledge-Innovation-Centre/quality-link-workflows.git
#MAGE_WORKFLOW_BRANCH=main

#==============================================================================
# BACKEND
#==============================================================================

# Database name (should match POSTGRES_DB or a specific DB your backend uses)
DB_NAME=backend


#==============================================================================
# SKILLDATA API (silver-stage AI enrichment)
#==============================================================================

# Setting SKILLDATA_API_URL enables the per-course call to
# POST {SKILLDATA_API_URL}/lo_generator/analyze_course during silver.
# The API key is optional; when set it is sent as the Kic-Api-Header.
#SKILLDATA_API_URL=https://skilldata.example.org
#SKILLDATA_API_KEY=your_skilldata_key
#SKILLDATA_API_TIMEOUT=60
#SKILLDATA_SKILL_LIMIT=5
#SKILLDATA_MAX_DISTANCE=0.3

#==============================================================================
# ETER API (student-to-staff ratios)
#==============================================================================

# Open data — no credentials needed. Pulled only on demand via
# `python cli.py eter fetch --year YYYY`; nothing schedules it.
#ETER_API_URL=https://eter-project.com/api/4.0/
#ETER_API_TIMEOUT=120

#==============================================================================
# MEILISEARCH
#==============================================================================

MEILISEARCH_URL=http://meili.example.org
#MEILISEARCH_INDEX=ql_courses

# Master key — used by the ETL to write documents.
MEILISEARCH_API_KEY=your_meili_key

# Search-only key served through the public proxy at GET|POST /api/v1/search.
# Must be scoped to the `search` action and the index above; the proxy returns
# 503 while it is unset rather than falling back to the master key. Mint one with:
#   curl -X POST $MEILISEARCH_URL/keys \
#     -H "Authorization: Bearer $MEILISEARCH_API_KEY" -H 'Content-Type: application/json' \
#     -d '{"description":"QL public search proxy","actions":["search"],
#          "indexes":["ql_courses"],"expiresAt":null}'
MEILISEARCH_SEARCH_KEY=your_meili_search_only_key

# Optional: cap on `limit` / `hitsPerPage` accepted by the public proxy.
#SEARCH_MAX_LIMIT=100

#==============================================================================
# FRONTEND CONFIGURATION
#==============================================================================

# Environment variables for the app
VITE_API_URL=$SERVICE_URL_BACKEND
VITE_RECAPTCHA_SITE_KEY=API_KEY
